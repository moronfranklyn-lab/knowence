# ============================================================================
#  知微 Knowence · 环境变量
#  用法：cp .env.example .env 然后改掉所有「必须修改」的项
# ============================================================================

# ---------------------------------------------------------------- 必改项 ⚠️
# 数据库密码
DB_PASSWORD=change-me-please

# JWT 签名密钥（随便一段长随机串）
JWT_SECRET=change-me-to-a-long-random-string

# 系统加密密钥（用于加密存储的模型 API Key，长度固定 16/24/32 字节）
SYSTEM_AES_KEY=change-me-32-bytes-key-here!!!

# ---------------------------------------------------------------- 端口
# 前端访问端口（浏览器打开这个）
UI_PORT=8081
# 后端 API 端口（一般不用直接访问）
APP_PORT=18080

# ---------------------------------------------------------------- 数据库
DB_USER=postgres
DB_NAME=WeKnora

# ---------------------------------------------------------------- 镜像
# 国内拉取 ghcr 慢的话，保留默认的南京大学镜像即可
LLAMACPP_IMAGE=ghcr.nju.edu.cn/ggml-org/llama.cpp:server
APP_IMAGE=wechatopenai/weknora-app:v0.8.2
UI_IMAGE=wechatopenai/weknora-ui:v0.8.2

# ---------------------------------------------------------------- 本地模型
# 文件名需与 scripts/download-models.sh 下载的一致
EMBED_MODEL_FILE=bge-m3-FP16.gguf
RERANK_MODEL_FILE=bge-reranker-v2-m3-FP16.gguf
# llama.cpp 推理线程数（建议设为 CPU 物理核数）
LLAMA_THREADS=8

# ---------------------------------------------------------------- 可选：局域网推理节点
# 若在另一台带 GPU 的机器上跑 Ollama，把它的 IP 填这里，
# 平台就能连上它（同时会加入 SSRF 白名单）。
# 留空则只使用本机服务 + 云端 API。
#   INFERENCE_NODE_IP=192.168.1.100
INFERENCE_NODE_IP=
